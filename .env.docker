APP_NAME=RENTeaza
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- MariaDB (serviciul "mariadb" din docker-compose) ---
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=renteaza
DB_USERNAME=renteaza
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mailpit (UI: http://localhost:8025) ---
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@renteaza.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- MinIO, inlocuieste S3 in local (consola: http://localhost:9001) ---
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=renteaza-private
AWS_PUBLIC_BUCKET=renteaza-public
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/renteaza-private
AWS_PUBLIC_URL=http://localhost:9000/renteaza-public
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Stripe (pune cheile tale de test ca sa mearga platile) ---
STRIPE_KEY=
STRIPE_SECRET=
PLATFORM_FEE_PCT=10

# --- Wise (payout catre proprietari) ---
WISE_BASE_URL=https://api.sandbox.transferwise.tech
WISE_API_TOKEN=
WISE_PROFILE_ID=

# --- Vonage (SMS) ---
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM=Renteaza

VITE_APP_NAME="${APP_NAME}"
VITE_AWS_PUBLIC_URL="${AWS_PUBLIC_URL}"
# fara cheie, hartile Google nu se incarca (restul aplicatiei merge)
VITE_GOOGLE_MAPS_API_KEY=
